rules_version = '2';

service cloud.firestore {
  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
                    && request.resource.data.role == "member"
                    && request.resource.data.email == request.auth.token.email;

      allow update: if isOwner(userId)
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.email == resource.data.email;

      allow delete: if isOwner(userId);
    }

    // 닉네임 문서 ID = 닉네임 그 자체. create는 문서가 아직 없을 때만 성공하고
    // update는 항상 거부되므로, 이미 존재하는 닉네임으로는 절대 쓸 수 없다(전역 유일성 보장).
    // 닉네임 변경/가입 취소 시 본인 소유 문서만 delete 가능.
    match /nicknames/{nickname} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // member < manager < admin 3단계. manager/admin(=운영진)은 공지 작성 + 다른 사람 글 관리 가능
    function currentRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaff() {
      return request.auth != null && currentRole() in ["manager", "admin"];
    }

    function isPostAuthor() {
      return request.auth != null && resource.data.authorUid == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorRole == currentRole()
                    && (request.resource.data.notice == false || isStaff());

      // 조회수는 누구나(비로그인 포함) +1씩만 증가 가능(임의 값 지정 방지).
      // 작성자 본인은 제목/내용/카테고리만 수정 가능하고 authorUid/authorName/authorRole/notice는
      // 건드릴 수 없음(자기 글을 공지로 자체 승격하거나 작성자/등급 배지를 바꿔치기하는 것 방지).
      // 그 필드들은 운영진만 변경 가능.
      allow update: if (isPostAuthor()
                          && request.resource.data.authorUid == resource.data.authorUid
                          && request.resource.data.authorName == resource.data.authorName
                          && request.resource.data.authorRole == resource.data.authorRole
                          && request.resource.data.notice == resource.data.notice)
                    || isStaff()
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["views"])
                          && request.resource.data.views == resource.data.views + 1);

      allow delete: if isPostAuthor() || isStaff();
    }

    match /posts/{postId}/comments/{commentId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorRole == currentRole()
                    && request.resource.data.deleted == false;

      // 수정은 살아있는 댓글에만: 본인은 내용 수정 또는 본인 삭제("self")만, 운영진은 정책 삭제("policy")만 가능
      allow update: if request.auth != null && resource.data.deleted == false && (
                      (resource.data.authorUid == request.auth.uid
                        && request.resource.data.authorUid == resource.data.authorUid
                        && request.resource.data.authorRole == resource.data.authorRole
                        && request.resource.data.deleted == false)
                      || (resource.data.authorUid == request.auth.uid
                        && request.resource.data.authorRole == resource.data.authorRole
                        && request.resource.data.deleted == true
                        && request.resource.data.deletedReason == "self")
                      || (isStaff()
                        && request.resource.data.deleted == true
                        && request.resource.data.deletedReason == "policy")
                    );

      allow delete: if false;
    }

    match /performance/{entryId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
