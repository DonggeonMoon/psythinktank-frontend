rules_version = '2';

service cloud.firestore {
  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }

  match /databases/{database}/documents {
    // member < manager < admin 3단계. manager/admin(=운영진)은 공지 작성 + 다른 사람 글 관리 가능
    function currentRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isStaff() {
      return request.auth != null && currentRole() in ["manager", "admin"];
    }

    // 봇은 운영진 권한이 없고, 관계 데이터처럼 자동화가 필요한 곳에서만 운영진과 같이 허용한다.
    function isStaffOrBot() {
      return request.auth != null && currentRole() in ["manager", "admin", "bot"];
    }

    function isAdmin() {
      return request.auth != null && currentRole() == "admin";
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 이메일 인증은 클라이언트 login()에서만 확인하면 SDK 직접 호출로 우회되므로 쓰기 규칙에서 강제한다.
    // 이관된 기존 회원(legacyUserId)은 인증 이력이 없어 예외로 둔다.
    function isVerified() {
      return request.auth.token.email_verified == true
             || currentUser().get("legacyUserId", null) != null
             || currentRole() == "bot";
    }

    function isValidCategory(category) {
      return category in ["domestic", "overseas"];
    }

    function postKeys() {
      return ["title", "contentHtml", "category", "authorUid", "authorName", "authorRole", "notice", "views", "legacyPostId", "createdAt", "updatedAt"];
    }

    // 리서치 봇이 자동 생성 글에 붙이는 번역·종목 메타데이터 필드.
    function botPostKeys() {
      return ["summary", "lang", "translationGroupId", "stockKey", "stockSymbol", "stockMarket", "autoGenerated"];
    }

    function isPostAuthor() {
      return request.auth != null && resource.data.authorUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();

      // 닉네임은 같은 batch에서 본인 소유 nicknames 문서를 함께 만든 경우에만 쓸 수 있다(중복·사칭 방지).
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(["email", "nickname", "role", "legacyUserId", "createdAt", "privacyConsent"])
                    && request.resource.data.role == "member"
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.legacyUserId == null
                    && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.nickname)).data.uid == userId;

      allow update: if (isOwner(userId)
                          && request.resource.data.role == resource.data.role
                          && request.resource.data.email == resource.data.email
                          && request.resource.data.get("legacyUserId", null) == resource.data.get("legacyUserId", null)
                          && (request.resource.data.get("nickname", null) == resource.data.get("nickname", null)
                                || getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.nickname)).data.uid == userId))
                    // 관리자 회원 관리 페이지에서의 승격/강등: role 필드만, member<->manager 사이에서만 허용.
                    // admin 승격/강등은 실수로 인한 권한 사고를 막기 위해 UI로 노출하지 않는다.
                    || (isAdmin()
                          && userId != request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["role"])
                          && resource.data.role in ["member", "manager"]
                          && request.resource.data.role in ["member", "manager"]);

      allow delete: if isOwner(userId);
    }

    // 닉네임 문서 ID = 닉네임 그 자체. create는 문서가 아직 없을 때만 성공하고
    // update는 항상 거부되므로, 이미 존재하는 닉네임으로는 절대 쓸 수 없다(전역 유일성 보장).
    // 개별 조회(중복 확인)만 허용하고 목록 조회는 막는다.
    // 생성은 커밋 후 본인 users 문서의 닉네임과 일치할 때만, 삭제는 더 이상 그 닉네임을 쓰지 않을 때만 허용한다.
    match /nicknames/{nickname} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(["uid"])
                    && request.resource.data.uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname == nickname;
      allow update: if false;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
                          || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickname != nickname);
    }

    // 이메일 문서 ID = 소문자로 정규화한 이메일. 구조는 nicknames와 동일 (전역 유일성 보장, update 금지).
    // 목록 조회를 열어두면 문서 ID만으로 전체 회원 이메일이 유출되므로 개별 조회만 허용한다.
    // 남의 이메일을 선점해 그 사람의 가입을 막지 못하도록 본인 계정 이메일로만 생성할 수 있다.
    match /emails/{email} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(["uid"])
                    && request.resource.data.uid == request.auth.uid
                    && request.auth.token.email != null
                    && email == request.auth.token.email.lower();
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
                    && isVerified()
                    && (request.resource.data.keys().hasOnly(postKeys())
                          || (currentRole() == "bot" && request.resource.data.keys().hasOnly(postKeys().concat(botPostKeys()))))
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.contentHtml is string
                    && isValidCategory(request.resource.data.category)
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.authorName == currentUser().nickname
                    && request.resource.data.authorRole == currentRole()
                    && request.resource.data.notice is bool
                    && (request.resource.data.notice == false || isStaff())
                    && request.resource.data.views == 0
                    && request.resource.data.legacyPostId == null
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;

      // 조회수는 누구나(비로그인 포함) +1씩만 증가 가능(임의 값 지정 방지).
      // 작성자 본인은 제목/내용/카테고리만 수정 가능하고 authorUid/authorName/authorRole/notice는
      // 건드릴 수 없음(자기 글을 공지로 자체 승격하거나 작성자/등급 배지를 바꿔치기하는 것 방지).
      // 그 필드들은 운영진만 변경 가능.
      allow update: if (isPostAuthor()
                          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "contentHtml", "category", "updatedAt"])
                                || (currentRole() == "bot"
                                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["title", "contentHtml", "category", "updatedAt"].concat(botPostKeys()))))
                          && request.resource.data.title is string
                          && request.resource.data.title.size() <= 200
                          && isValidCategory(request.resource.data.category)
                          && request.resource.data.updatedAt == request.time)
                    || (isStaff()
                          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["category"])
                                || isValidCategory(request.resource.data.category)))
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["views"])
                          && request.resource.data.views == resource.data.views + 1);

      allow delete: if isPostAuthor() || isStaff();
    }

    function isValidCommentContent(content) {
      return content is string && content.size() > 0 && content.size() <= 5000;
    }

    function canCreateComment() {
      return request.auth != null
             && isVerified()
             && request.resource.data.keys().hasOnly(["content", "authorUid", "authorName", "authorRole", "deleted", "deletedReason", "createdAt", "updatedAt"])
             && isValidCommentContent(request.resource.data.content)
             && request.resource.data.authorUid == request.auth.uid
             && request.resource.data.authorName == currentUser().nickname
             && request.resource.data.authorRole == currentRole()
             && request.resource.data.deleted == false
             && request.resource.data.deletedReason == null
             && request.resource.data.createdAt == request.time
             && request.resource.data.updatedAt == request.time;
    }

    // 수정은 살아있는 댓글에만: 본인은 내용 수정 또는 본인 삭제("self")만, 운영진은 정책 삭제("policy")만 가능
    function canUpdateComment() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let isDeletion = changed.hasOnly(["content", "deleted", "deletedReason", "updatedAt"])
                       && request.resource.data.content == ""
                       && request.resource.data.deleted == true;
      return request.auth != null && resource.data.deleted == false && (
               (resource.data.authorUid == request.auth.uid
                 && changed.hasOnly(["content", "updatedAt"])
                 && isValidCommentContent(request.resource.data.content))
               || (resource.data.authorUid == request.auth.uid
                 && isDeletion
                 && request.resource.data.deletedReason == "self")
               || (isStaff()
                 && isDeletion
                 && request.resource.data.deletedReason == "policy")
             );
    }

    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if canCreateComment();
      allow update: if canUpdateComment();
      allow delete: if false;
    }

    // 종목 상세 댓글. 부모 stocks/{symbol} 문서는 만들지 않고 서브컬렉션만 사용한다.
    match /stocks/{symbol}/comments/{commentId} {
      allow read: if true;
      allow create: if canCreateComment();
      allow update: if canUpdateComment();
      allow delete: if false;
    }

    // 게시글-종목 관계. 문서 ID를 {postId}_{symbol}로 고정해 같은 관계의 중복 저장을 막는다.
    // 게시글 작성/삭제와 같은 batch로 커밋되므로, 생성은 getAfter(커밋 후 게시글)로,
    // 삭제는 get(커밋 전 게시글)으로 게시글 작성자 여부를 확인한다.
    match /related_posts/{relationId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(["postId", "symbol", "createdAt"])
                    && request.resource.data.postId is string
                    && request.resource.data.symbol is string
                    && relationId == request.resource.data.postId + "_" + request.resource.data.symbol
                    && (getAfter(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorUid == request.auth.uid
                          || isStaffOrBot());

      allow update: if false;

      allow delete: if request.auth != null
                    && (get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.authorUid == request.auth.uid
                          || isStaffOrBot());
    }

    match /performance/{entryId} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
